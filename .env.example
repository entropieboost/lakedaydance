# =========================================================================
# Client-Side Firebase Configuration (Required for Real-time Leaderboard)
# =========================================================================
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_auth_domain_here
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id_here
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_storage_bucket_here
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id_here
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id_here

# =========================================================================
# Server-Side Firebase Admin Configuration (Required for Score Validation API)
# =========================================================================
# Copy the contents of your downloaded Firebase Service Account JSON file here.
# Make sure to keep it on a single line with escaped newlines (\n) in the private key.
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"your_project_id_here","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n","client_email":"firebase-adminsdk-xxxxx@your_project_id.iam.gserviceaccount.com"}
